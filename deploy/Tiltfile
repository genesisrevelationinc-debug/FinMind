k8s_yaml('k8s/*.yaml')

docker_build('finmind-backend', '.', live_update=[
    sync('.', '/app'),
    run('pip install -r requirements.txt'),
])

k8s_resource('finmind-backend', port_forwards=5000, resource_selectors=['app=finmind-backend'])

local_resource('frontend', cmd='npm run dev', port_forwards=3000, resource_deps=['finmind-backend'])

allow_k8s_contexts('minikube', 'docker-desktop')

watch_file('backend/app/db/schema.sql', run='kubectl exec -it $(kubectl get pods -l app=finmind-backend -o jsonpath="{.items[0].metadata.name}") -- psql -U user -d finmind -f /app/backend/app/db/schema.sql')

watch_file('backend/app/config.py', run='kubectl rollout restart deployment finmind-backend')

watch_file('backend/app/routes/*.py', run='kubectl rollout restart deployment finmind-backend')

watch_file('backend/app/models.py', run='kubectl rollout restart deployment finmind-backend')

watch_file('backend/app/extensions.py', run='kubectl rollout restart deployment finmind-backend')

watch_file('backend/app/__init__.py', run='kubectl rollout restart deployment finmind-backend')

watch_file('backend/app/openapi.yaml', run='kubectl rollout restart deployment finmind-backend')