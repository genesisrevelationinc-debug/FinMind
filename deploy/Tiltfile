k8s_yaml('k8s/deployment.yaml')
k8s_resource('finmind-backend', port_forwards=8000)
k8s_resource('finmind-frontend', port_forwards=3000)

docker_build('finmind-backend', './app')
docker_build('finmind-frontend', './frontend')

local_resource(
    'setup',
    cmd='kubectl apply -f k8s/namespace.yaml',
    resource_deps=['finmind-backend', 'finmind-frontend']
)

local_resource(
    'cleanup',
    cmd='kubectl delete -f k8s/namespace.yaml',
    resource_deps=['finmind-backend', 'finmind-frontend']
)

allow_k8s_contexts('minikube', 'docker-desktop')